// Math&Bro database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String?
  avatarColor  String        @default("#344CDB")
  isGuest      Boolean       @default(false)
  totalGames   Int           @default(0)
  wins         Int           @default(0)
  losses       Int           @default(0)
  draws        Int           @default(0)
  totalScore   Int           @default(0)
  bestScore    Int           @default(0)
  createdAt    DateTime      @default(now())
  matches      MatchPlayer[]
}

enum MatchStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

model Match {
  id            String            @id @default(cuid())
  roomCode      String
  status        MatchStatus       @default(ACTIVE)
  gameType      String
  /// Room settings chosen by the host (time control, score mode, challenge, voice …)
  settings      Json
  /// Full rule configuration used by the engine (frozen at game start)
  rules         Json
  /// Private engine snapshot used to recover games after a server restart
  state         Json?
  result        Json?
  winnerSide    Int?
  endReason     String?
  replayEnabled Boolean           @default(true)
  totalMoves    Int               @default(0)
  durationMs    Int?
  startedAt     DateTime          @default(now())
  endedAt       DateTime?
  players       MatchPlayer[]
  moves         MoveRecord[]
  challenges    ChallengeRecord[]

  @@index([status])
  @@index([roomCode])
}

model MatchPlayer {
  id          String  @id @default(cuid())
  matchId     String
  userId      String
  side        Int
  username    String
  finalScore  Int?
  outcome     String? // WIN | LOSS | DRAW
  bingoCount  Int     @default(0)
  timePenalty Int     @default(0)
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}

model MoveRecord {
  id          String   @id @default(cuid())
  matchId     String
  seq         Int
  moveNumber  Int
  type        String
  side        Int?
  playerId    String?
  placements  Json?
  equations   Json?
  points      Int      @default(0)
  bingo       Boolean  @default(false)
  status      String?
  timeUsedMs  Int      @default(0)
  /// Full engine record (score breakdown, racks after move for replay, …)
  data        Json
  occurredAt  DateTime
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, seq])
}

model ChallengeRecord {
  id                     String    @id @default(cuid())
  matchId                String
  challengeKey           String
  moveNumber             Int
  challengerId           String
  challengedId           String
  equations              Json
  firstResult            Json
  secondResult           Json?
  rechallengeRequestedBy String?
  rechallengeRequestedAt DateTime?
  requestedAt            DateTime
  finalRuling            String?
  resolvedAt             DateTime?
  match                  Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, challengeKey])
}
